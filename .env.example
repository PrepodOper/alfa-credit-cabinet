# Секрет подписи JWT — обязательно заменить в проде
JWT_SECRET=change-me-in-production
# Время жизни токена, часы
ACCESS_TOKEN_TTL_HOURS=12
# Масштаб искусственных задержек конвейера (0 — без задержек, 1 — полные паузы профиля)
DEMO_DELAY_SCALE=1.0
# Профиль времени этапов: demo — показ за ~2 с, realistic — правдоподобные ~3 мин
TIMING_PROFILE=demo
# Разрешённые origin для CORS (через запятую, * — все)
CORS_ORIGINS=*
# Сколько часов действует сформированное предложение
OFFER_TTL_HOURS=168
# Каталог собранного фронтенда для раздачи из FastAPI (опционально)
STATIC_DIR=
